# ========================================================
# DOMAIN & SSL CONFIGURATION (CADDY REVERSE PROXY)
# ========================================================
# Di VPS: Ganti dengan domain asli Anda (misal: winteknikmandiri.com)
# Di Local: Biarkan localhost
DOMAIN=localhost
CADDY_EMAIL=admin@winteknikmandiri.com

# ========================================================
# DATABASE CONFIGURATION (POSTGRESQL)
# ========================================================
DB_HOST=postgres
DB_PORT=5432
# Port host untuk mengakses PostgreSQL dari laptop/DBeaver.
# Default 5432 (VPS). Set 5433 di lokal jika ada PostgreSQL native di 5432.
DB_HOST_PORT=5432
DB_USER=wtm_user
DB_PASSWORD=Wtm_S3cur3#P0stgr3s!2026
DB_NAME=wtm_db
DB_SSLMODE=disable

# ========================================================
# BACKEND API (GOLANG GIN)
# ========================================================
PORT=8080

# ========================================================
# FRONTEND (NEXT.JS + BUN)
# ========================================================
NEXT_PUBLIC_API_URL=http://localhost:8080

# ========================================================
# OBJECT STORAGE (MINIO S3-COMPATIBLE)
# ========================================================
MINIO_ROOT_USER=wtm_admin
MINIO_ROOT_PASSWORD=Wtm_M1n10#S3cur3!2026
# Port host MinIO API & Web Console (hanya terikat ke 127.0.0.1)
# Port console 9091 dipakai agar tidak bentrok dengan Intel Graphics (igccservice) pada port 9001
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9091
MINIO_BUCKET=wtm-media
# Base URL publik untuk mengakses media lewat Caddy (/media/...)
MINIO_PUBLIC_URL=http://localhost/media
