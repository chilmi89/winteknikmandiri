    "definitions": {
        "dto.CreateFAQRequest": {
            "type": "object",
            "required": [
                "answer",
                "question"
            ],
            "properties": {
                "answer": {
                    "type": "string",
                    "minLength": 5
                },
                "category": {
                    "type": "string",
                    "maxLength": 100
                },
                "is_active": {
                    "type": "boolean"
                },
                "question": {
                    "type": "string",
                    "minLength": 5
                },
                "sort_order": {
                    "type": "integer"
                }
            }
        },
        "dto.CreateInquiryRequest": {
            "type": "object",
            "required": [
                "name",
                "notes",
                "phone",
                "service"
            ],
            "properties": {
                "address": {
                    "type": "string",
                    "maxLength": 255
                },
                "name": {
                    "type": "string",
                    "maxLength": 150,
                    "minLength": 2
                },
                "notes": {
                    "type": "string"
                },
                "phone": {
                    "type": "string",
                    "maxLength": 50,
                    "minLength": 6
                },
                "service": {
                    "type": "string",
                    "maxLength": 100
                }
            }
        },
        "dto.CreateInquiryResponse": {
            "type": "object",
            "properties": {
                "data": {
                    "$ref": "#/definitions/dto.InquiryResponse"
                },
                "message": {
                    "type": "string",
                    "example": "Permohonan konsultasi berhasil disimpan"
                }
            }
        },
        "dto.CreateJamOperasionalRequest": {
            "type": "object",
            "required": [
                "day_label",
                "hours"
            ],
            "properties": {
                "day_label": {
                    "type": "string",
                    "maxLength": 100,
                    "minLength": 2,
                    "example": "Senin – Jumat"
                },
