{
    "swagger": "2.0",
    "info": {
        "description": "REST API layanan AC, ducting, dan cold storage CV Win Teknik Mandiri.\nSeluruh endpoint mengembalikan JSON. Data disimpan di PostgreSQL dengan query native (database/sql + pgx), tanpa ORM.",
        "title": "CV Win Teknik Mandiri API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/",
    "paths": {
        "/api/v1/faqs": {
            "get": {
                "description": "Endpoint publik. Secara default hanya mengembalikan FAQ aktif, urut sort_order.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "faqs"
                ],
                "summary": "Daftar FAQ",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Filter kategori",
                        "name": "category",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Cari pada pertanyaan atau jawaban",
                        "name": "search",
                        "in": "query"
                    },
                    {
                        "type": "boolean",
                        "description": "Ikutkan FAQ non-aktif (untuk dashboard)",
                        "name": "include_inactive",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "default": 20,
                        "description": "Jumlah data per halaman (default 20, maks 100)",
                        "name": "limit",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "default": 0,
                        "description": "Offset pagination",
                        "name": "offset",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/dto.ListFAQResponse"
                        }
                    },
                    "400": {
                        "description": "Parameter query tidak valid",
                        "schema": {
                            "$ref": "#/definitions/httpx.ErrorResponse"
                        }
                    },
                    "503": {
                        "description": "Database tidak terhubung",
                        "schema": {
                            "$ref": "#/definitions/httpx.ErrorResponse"
                        }
                    }
                }
            },
            "post": {
                "description": "Menambahkan FAQ. is_active default true bila tidak dikirim.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "faqs"
                ],
                "summary": "Buat FAQ baru",
                "parameters": [
                    {
                        "description": "Data FAQ",
                        "name": "payload",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/dto.CreateFAQRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/dto.FAQEnvelope"
                        }
                    },
                    "400": {
                        "description": "Input tidak valid",
                        "schema": {
                            "$ref": "#/definitions/httpx.ErrorResponse"
                        }
                    },
                    "503": {
                        "description": "Database tidak terhubung",
                        "schema": {
                            "$ref": "#/definitions/httpx.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/faqs/{id}": {
            "get": {
                "description": "Mengambil satu FAQ berdasarkan ID.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "faqs"
                ],
                "summary": "Detail FAQ",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "ID FAQ",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/dto.FAQEnvelope"
                        }
                    },
                    "400": {
                        "description": "ID tidak valid",
                        "schema": {
                            "$ref": "#/definitions/httpx.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "FAQ tidak ditemukan",
                        "schema": {
                            "$ref": "#/definitions/httpx.ErrorResponse"
                        }
                    },
                    "503": {
                        "description": "Database tidak terhubung",
                        "schema": {
                            "$ref": "#/definitions/httpx.ErrorResponse"
                        }
                    }
                }
            },
            "put": {
                "description": "Field opsional (category, sort_order, is_active) dipertahankan bila tidak dikirim.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "faqs"
                ],
                "summary": "Perbarui FAQ",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "ID FAQ",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Data FAQ",
                        "name": "payload",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/dto.UpdateFAQRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/dto.FAQEnvelope"
                        }
                    },
                    "400": {
                        "description": "Input tidak valid",
                        "schema": {
                            "$ref": "#/definitions/httpx.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "FAQ tidak ditemukan",
                        "schema": {
                            "$ref": "#/definitions/httpx.ErrorResponse"
                        }
                    },
                    "503": {
                        "description": "Database tidak terhubung",
                        "schema": {
                            "$ref": "#/definitions/httpx.ErrorResponse"
                        }
                    }
                }
            },
            "delete": {
                "description": "Soft delete: data tidak dihapus permanen, hanya diisi deleted_at.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "faqs"
                ],
                "summary": "Hapus FAQ",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "ID FAQ",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/dto.FAQMessageResponse"
                        }
                    },
                    "400": {
                        "description": "ID tidak valid",
                        "schema": {
                            "$ref": "#/definitions/httpx.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "FAQ tidak ditemukan",
                        "schema": {
                            "$ref": "#/definitions/httpx.ErrorResponse"
                        }
                    },
                    "503": {
                        "description": "Database tidak terhubung",
                        "schema": {
                            "$ref": "#/definitions/httpx.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/inquiries": {
            "get": {
                "description": "Menampilkan permohonan terbaru beserta total data (untuk dashboard).",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "inquiries"
                ],
                "summary": "Daftar permohonan konsultasi",
                "parameters": [
                    {
                        "type": "integer",
                        "default": 20,
                        "description": "Jumlah data per halaman (default 20, maks 100)",
                        "name": "limit",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "default": 0,
                        "description": "Offset pagination",
                        "name": "offset",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/dto.ListInquiryResponse"
                        }
                    },
                    "400": {
                        "description": "Parameter query tidak valid",
                        "schema": {
                            "$ref": "#/definitions/httpx.ErrorResponse"
                        }
                    },
                    "503": {
                        "description": "Database tidak terhubung",
                        "schema": {
                            "$ref": "#/definitions/httpx.ErrorResponse"
                        }
                    }
                }
            },
            "post": {
                "description": "Menyimpan permohonan dari formulir kontak website. Status awal selalu \"pending\".",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "inquiries"
                ],
                "summary": "Kirim permohonan konsultasi",
                "parameters": [
                    {
                        "description": "Data permohonan",
                        "name": "payload",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/dto.CreateInquiryRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/dto.CreateInquiryResponse"
                        }
                    },
                    "400": {
                        "description": "Input tidak valid",
                        "schema": {
                            "$ref": "#/definitions/httpx.ErrorResponse"
                        }
                    },
                    "503": {
                        "description": "Database tidak terhubung",
                        "schema": {
                            "$ref": "#/definitions/httpx.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/health": {
            "get": {
                "description": "Menunjukkan status server dan koneksi database PostgreSQL.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "system"
                ],
                "summary": "Health check",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/httpx.HealthResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "dto.CreateFAQRequest": {
            "type": "object",
            "required": [
                "answer",
                "question"
            ],
            "properties": {
                "answer": {
                    "type": "string",
                    "minLength": 5
                },
                "category": {
                    "type": "string",
                    "maxLength": 100
                },
                "is_active": {
                    "type": "boolean"
                },
                "question": {
                    "type": "string",
                    "minLength": 5
                },
                "sort_order": {
                    "type": "integer"
                }
            }
        },
        "dto.CreateInquiryRequest": {
            "type": "object",
            "required": [
                "name",
                "notes",
                "phone",
                "service"
            ],
            "properties": {
                "address": {
                    "type": "string",
                    "maxLength": 255
                },
                "name": {
                    "type": "string",
                    "maxLength": 150,
                    "minLength": 2
                },
                "notes": {
                    "type": "string"
                },
                "phone": {
                    "type": "string",
                    "maxLength": 50,
                    "minLength": 6
                },
                "service": {
                    "type": "string",
                    "maxLength": 100
                }
            }
        },
        "dto.CreateInquiryResponse": {
            "type": "object",
            "properties": {
                "data": {
                    "$ref": "#/definitions/dto.InquiryResponse"
                },
                "message": {
                    "type": "string",
                    "example": "Permohonan konsultasi berhasil disimpan"
                }
            }
        },
        "dto.FAQEnvelope": {
            "type": "object",
            "properties": {
                "data": {
                    "$ref": "#/definitions/dto.FAQResponse"
                },
                "message": {
                    "type": "string",
                    "example": "FAQ berhasil dibuat"
                }
            }
        },
        "dto.FAQMessageResponse": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string",
                    "example": "FAQ berhasil dihapus"
                }
            }
        },
        "dto.FAQResponse": {
            "type": "object",
            "properties": {
                "answer": {
                    "type": "string"
                },
                "category": {
                    "type": "string"
                },
                "created_at": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "is_active": {
                    "type": "boolean"
                },
                "question": {
                    "type": "string"
                },
                "sort_order": {
                    "type": "integer"
                },
                "updated_at": {
                    "type": "string"
                }
            }
        },
        "dto.InquiryResponse": {
            "type": "object",
            "properties": {
                "address": {
                    "type": "string"
                },
                "created_at": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "name": {
                    "type": "string"
                },
                "notes": {
                    "type": "string"
                },
                "phone": {
                    "type": "string"
                },
                "service": {
                    "type": "string"
                },
                "status": {
                    "type": "string"
                },
                "updated_at": {
                    "type": "string"
                }
            }
        },
        "dto.ListFAQResponse": {
            "type": "object",
            "properties": {
                "data": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/dto.FAQResponse"
                    }
                },
                "limit": {
                    "type": "integer"
                },
                "offset": {
                    "type": "integer"
                },
                "total": {
                    "type": "integer"
                }
            }
        },
        "dto.ListInquiryResponse": {
            "type": "object",
            "properties": {
                "data": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/dto.InquiryResponse"
                    }
                },
                "limit": {
                    "type": "integer"
                },
                "offset": {
                    "type": "integer"
                },
                "total": {
                    "type": "integer"
                }
            }
        },
        "dto.UpdateFAQRequest": {
            "type": "object",
            "required": [
                "answer",
                "question"
            ],
            "properties": {
                "answer": {
                    "type": "string",
                    "minLength": 5
                },
                "category": {
                    "type": "string",
                    "maxLength": 100
                },
                "is_active": {
                    "type": "boolean"
                },
                "question": {
                    "type": "string",
                    "minLength": 5
                },
                "sort_order": {
                    "type": "integer"
                }
            }
        },
        "httpx.ErrorResponse": {
            "type": "object",
            "properties": {
                "details": {},
                "error": {
                    "type": "string",
                    "example": "Validasi gagal"
                }
            }
        },
        "httpx.HealthResponse": {
            "type": "object",
            "properties": {
                "database": {
                    "type": "string",
                    "example": "connected"
                },
                "service": {
                    "type": "string",
                    "example": "CV Win Teknik Mandiri API"
                },
                "status": {
                    "type": "string",
                    "example": "healthy"
                },
                "timestamp": {
                    "type": "string",
                    "example": "2026-11-01T08:00:00+07:00"
                }
            }
        }
    },
    "securityDefinitions": {
        "AdminToken": {
            "type": "apiKey",
            "name": "X-Admin-Token",
            "in": "header"
        }
    }
}