# ========================================================
# BACKEND ENV EXAMPLE
# ========================================================
# Ada dua mode pemakaian:
#
# 1. LOKAL (PostgreSQL native / `npm run dev:backend`)
#    Salin file ini menjadi `backend/.env` lalu pakai nilai berikut:
#    DB_HOST=localhost
#    DB_PORT=5432
#    DB_NAME=wtm_db_local
#
# 2. DOCKER / VPS (dipakai oleh docker-compose)
#    Nilai di bawah ini yang benar; container mengakses service `postgres`.
# --------------------------------------------------------
PORT=8080
DB_HOST=postgres
DB_PORT=5432
DB_USER=wtm_user
DB_PASSWORD=Wtm_S3cur3#P0stgr3s!2026
DB_NAME=wtm_db
DB_SSLMODE=disable

# Dokumentasi API (Swagger UI) di /swagger/index.html
# - lokal : true
# - VPS   : biarkan false (default docker-compose), set true hanya bila perlu dibuka
SWAGGER_ENABLED=false

# ========================================================
# OBJECT STORAGE (MINIO S3-COMPATIBLE)
# ========================================================
# - Mode Lokal: localhost:9000
# - Mode Docker / VPS: minio:9000
STORAGE_ENDPOINT=minio:9000
STORAGE_ACCESS_KEY=wtm_admin
STORAGE_SECRET_KEY=Wtm_M1n10#S3cur3!2026
STORAGE_BUCKET=wtm-media
STORAGE_SSL=false
STORAGE_PUBLIC_BASE_URL=http://localhost/media
