{
	# Email untuk notifikasi sertifikat SSL Let's Encrypt saat deploy ke VPS
	email {$CADDY_EMAIL:admin@winteknikmandiri.com}
}

{$DOMAIN:localhost} {
	# Kompresi performa tinggi
	encode gzip zstd

	# Routing Backend Go Gin API
	handle /api/* {
		reverse_proxy backend:8080
	}

	# Routing Health Check API
	handle /health {
		reverse_proxy backend:8080
	}

	# Dokumentasi API (Swagger UI). Nonaktifkan di backend dengan SWAGGER_ENABLED=false.
	redir /swagger /swagger/index.html
	handle /swagger/* {
		reverse_proxy backend:8080
	}

	# Routing Media / Objek Storage Publik (MinIO)
	# Mengakses: https://domain.com/media/wtm-media/services/foto.jpg
	# Diteruskan ke MinIO sebagai: minio:9000/wtm-media/services/foto.jpg
	handle_path /media/* {
		header Cache-Control "public, max-age=86400"
		reverse_proxy minio:9000
	}

	# Routing Frontend Next.js
	handle {
		reverse_proxy frontend:3000
	}
}
